  <IndexSectionLayout title="Trackers">
    <div class="mb-20 flex max-sm:flex-col">
      <TrackerLayout title="Reading">
        <CurrentlyReading />
      </TrackerLayout>
    </div>
    <div class="flex max-sm:flex-col">
      <TrackerLayout title="Listening">
        <CurrentlyListening client:load />
      </TrackerLayout>
    </div>
  </IndexSectionLayout>
