---
import CurrentlyListening from "../components/CurrentlyListening";
import CurrentlyReading from "../components/CurrentlyReading.astro";
import PostList from "../components/PostList.astro";
import PostListItem from "../components/PostListItem.astro";
import IndexSectionLayout from "../layouts/IndexSectionLayout.astro";
import Layout from "../layouts/Layout.astro";
import TrackerLayout from "../layouts/TrackerLayout.astro";
---

<Layout title="Roland Tóth">
  <section class="my-36 flex flex-col gap-0">
    <h1 class="text-lg font-medium text-light-600 dark:text-dark-0">
      Roland Tóth
    </h1>
    <p class="text-base font-normal text-light-500/80 dark:text-dark-200">
      /ˈrolɒnd toːt/
    </p>
  </section>
  <section
    class="mb-24 flex flex-col gap-3 text-light-500/80 dark:text-dark-200"
  >
    <h2 class="text-lg text-light-600 dark:text-dark-0">Welcome!</h2>
    <p class="text-justify">
      <!-- Suspendisse feugiat, metus sed pulvinar sodales, diam urna aliquet magna,
      ut condimentum tortor purus at tellus. Interdum et malesuada fames ac ante
      ipsum primis in faucibus. Vestibulum imperdiet dui turpis, et interdum
      tellus lacinia ullamcorper. Aliquam erat volutpat. -->
      Hi, I’m Roland, a software engineer with a degree from the Budapest University
      of Technology and Economics. I’ve worked on various projects, including an
      internship at <a
        class="underline dark:text-dark-100"
        href="https://www.audi.hu/">Audi</a
      >, where I gained practical experience in software development.
    </p>
    <p>
      In my free time, I enjoy running and hiking — anything that gets me
      outdoors. Feel free to check out my website to know what I'm currently up
      to or get in touch through either <a
        class="underline dark:text-dark-100"
        href="mailto:hi@rolandtoth.com">e-mail</a
      > or <a class="underline dark:text-dark-100" href="https://x.com/rlndtth"
        >X</a
      >.
    </p>
  </section>
  <div class="mb-24">
    <header
      class="mb-24 flex items-baseline justify-between border-b dark:border-b-dark-500/75"
    >
      <h2 class="pb-3 text-lg text-light-600 dark:text-dark-0">Latest posts</h2>
      <a href="#" class="flex items-center gap-1 text-xsm dark:text-dark-200">
        <!-- <RSSIcon size={16} /> -->
        <span
          class="relative after:absolute after:bottom-0 after:left-0 after:h-[1px] after:w-full after:bg-dark-400 after:transition-colors after:hover:bg-dark-300/90"
          >RSS</span
        ></a
      >
    </header>
    <ul>
      <PostList />
    </ul>
  </div>
