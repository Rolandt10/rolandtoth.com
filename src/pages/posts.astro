---
import { getCollection } from "astro:content";
import PostListItem from "../components/Posts/PostListItem.astro";
import PostsProcessor from "../utils/PostsProcessor.ts";
import Main from "../layouts/Main.astro";
import { RSSIcon } from "../components/Icons/Icons";

const posts = await getCollection("posts");
console.log(posts);
const processedPosts = new PostsProcessor(posts).processPosts();
---

<Main title="Posts">
  <main class="mb-24 [grid-area:main]">
    <div class="my-32 flex justify-between">
      <h1 class="text-lg text-light-600 dark:text-dark-0">Posts</h1>
      <a
        href="/rss.xml"
        class="text-light-500 dark:text-dark-300 dark:hover:text-dark-100"
        ><RSSIcon size={18} /></a
      >
    </div>
    {
      processedPosts.map(([year, posts]) => (
        <section class="mb-24 last:mb-0">
          <h2 class="mb-10 mt-8 text-lg dark:text-dark-0">{year}</h2>
          <ul>
            {posts.map((post) => (
              <li>
                <PostListItem
                  title={post.data.title}
                  releaseDate={post.data.date}
                  timeToRead={post.readTime}
                  href={`/posts/${post.slug}`}
                />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Main>
