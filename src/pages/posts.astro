---
import { getCollection } from "astro:content";
import PostListItem from "../components/PostListItem.astro";
import Layout from "../layouts/Layout.astro";
import PostsProcessor from "../utils/PostsProcessor.ts";

const posts = await getCollection("posts");
const processedPosts = new PostsProcessor(posts).processPosts();
---

<Layout title="Posts">
  <main class="mb-24 [grid-area:main]">
    <h1 class="my-36 text-xl text-light-600 dark:text-dark-0">Posts</h1>
    {
      processedPosts.map(([year, posts]) => (
        <section class="mb-24 last:mb-0">
          <h2 class="mb-10 mt-8 text-lg dark:text-dark-0">{year}</h2>
          <ul>
            {posts.map((post) => (
              <li>
                <PostListItem
                  title={post.data.title}
                  releaseDate={post.data.date}
                  timeToRead={post.readTime}
                  href={`/posts/${post.slug}`}
                />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </main>
</Layout>
