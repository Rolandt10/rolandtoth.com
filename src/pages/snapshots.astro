---
import Gallery from "../components/Gallery/Gallery.astro";
import Main from "../layouts/Main.astro";
---

<Main title="Snapshots" isFullSpan={true}>
  <div class="mb-24">
    <div class="mx-auto my-32 max-w-[min(620px,100%)]">
      <h1 class="mb-6 text-lg text-light-600 dark:text-dark-0">Snapshots</h1>
      <p class="mb-8 text-sm text-light-400 dark:text-dark-300">
        A collection of raw, unedited photos — an image dump of things I find
        interesting or beautiful, mainly from hikes (sometimes running) and
        nature. Shot on iPhone 12 Mini.
      </p>
    </div>
    <Gallery />
  </div>
</Main>
