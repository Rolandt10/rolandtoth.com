---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("posts");
const { slug } = Astro.params;
const post = posts.find((p) => p.slug === slug);

if (!post) {
  throw new Error(`Post not found: ${slug}`);
}

const { Content } = await post.render();
---

<Layout>
  <h1 class="my-36 text-xl dark:text-dark-0">{post.data.title}</h1>
  <article class="markdown-content">
    <Content />
  </article>
  <div class="my-24 flex justify-between">
    <a
      href="/posts"
      class="w-max rounded-full border border-dark-500 px-3 py-1 text-sm hover:dark:border-dark-400/50"
      >&leftarrow; Back to posts</a
    >
    <span class="text-sm">
      Published on <time datetime="">{post.data.date}</time>
    </span>
  </div>
</Layout>
