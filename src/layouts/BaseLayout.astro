---
import { ViewTransitions } from "astro:transitions";
import ResizeHandler from "../components/ResizeHandler.astro";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full bg-light-100 dark:bg-dark-800 dark:text-dark-100">
  <head>
    <style>
      @font-face {
        font-family: "Inter";
        font-style: normal;
        font-weight: 300 900;
        font-display: fallback;
        src: url("/fonts/Inter-optimized.woff2") format("woff2");
      }
    </style>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🤯</text></svg>"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body class="mx-6 mt-14 h-full font-inter text-base">
    <slot />
  </body><ResizeHandler />
</html>
<style is:global>
  [cmdk-overlay] {
    @apply bg-light-600/20 dark:bg-dark-600/60;
    @apply fixed left-0 top-0;
    @apply h-full w-full;
    @apply backdrop-blur-sm;
  }

  [cmdk-dialog] {
    @apply absolute left-2/4 top-2/4 -translate-x-2/4 -translate-y-2/4;
    @apply border border-light-400/25 dark:border-dark-400/50;
    @apply rounded-xl;
    @apply w-full max-w-sm;
    @apply shadow-md;
    @apply px-5 pb-2 pt-5;
    @apply font-inter;
    @apply bg-light-100 dark:bg-dark-500;
  }

  [cmdk-input] {
    @apply w-full;
    @apply bg-[transparent];
    @apply outline-none;
    @apply placeholder:text-light-400/65 dark:text-dark-100 dark:placeholder:text-dark-300/90;
  }

  [cmdk-group] {
    @apply mt-5;
  }

  [cmdk-group-heading] {
    @apply text-xsm;
    @apply font-normal;
    @apply text-light-400 dark:text-dark-100;
    @apply mb-1;
  }

  [cmdk-group-items] {
    @apply flex flex-col;
  }

  [cmdk-item] a {
    @apply flex items-center gap-3;
    @apply text-base;
    @apply font-normal;
    @apply text-light-500 dark:text-dark-200;
    @apply cursor-pointer;
    @apply py-2;
    @apply -mx-3;
    @apply px-3;
  }

  [cmdk-item] a:hover {
    @apply bg-light-300/45 dark:bg-dark-600/60;
    @apply rounded-md dark:text-dark-100;
    @apply -mx-3;
    @apply px-3;
  }

  .markdown-content p:not(:last-child) {
    margin-bottom: 2rem;
    line-height: 1.5;
  }

  body.stop-transitions * {
    transition: none !important;
  }
</style>
