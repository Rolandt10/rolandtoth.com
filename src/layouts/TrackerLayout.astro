---
const { title } = Astro.props;
---

<div class="w-1/2 max-sm:mb-12">
  <div
    class="inline-block rounded-full border border-light-400/20 bg-light-300/20 px-4 py-2 dark:border-dark-600 dark:bg-dark-700"
  >
    {title}
  </div>
</div>
<div class="flex w-1/2 gap-4 max-sm:w-full">
  <slot />
</div>
