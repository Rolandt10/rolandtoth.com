---
import { getCollection } from "astro:content";
import PostListItem from "./PostListItem.astro";
import readingTime from "reading-time";

const posts = await getCollection("posts");

posts.forEach((post) => {
  post.readTime = Math.round(readingTime(post.body).minutes);
});

console.log(posts);
---

<ul>
  {
    posts.map((post) => (
      <PostListItem
        title={post.data.title}
        href={`/posts/${post.slug}`}
        releaseDate={new Date(post.data.date).toISOString().split("T")[0]}
        timeToRead={post.readTime}
      />
    ))
  }
</ul>
