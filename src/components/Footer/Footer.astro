---
import FooterLink from "../Links/FooterLink.astro";
---

<footer
  class="flex flex-wrap border-t border-dashed border-light-300 py-20 [grid-area:footer] dark:border-dark-500/75"
>
  <div class="flex w-1/2 flex-col">
    <span class="mb-8 text-light-600 dark:text-dark-0">Browse</span>
    <ul>
      <li class="mb-3 w-max">
        <FooterLink href="/snapshots">Snapshots</FooterLink>
      </li>
      <li class="mb-3 w-max">
        <FooterLink href="/posts">Posts</FooterLink>
      </li>
    </ul>
  </div>
  <div class="flex w-1/2 flex-col">
    <span class="mb-8 text-light-600 dark:text-dark-0">Contact</span>
    <ul>
      <li class="mb-3 w-max">
        <FooterLink href="https://x.com/rlndtth">Twitter / X</FooterLink>
      </li>
      <li class="mb-3 w-max">
        <FooterLink href="mailto:hi@rolandtoth.com">E-mail</FooterLink>
      </li>
    </ul>
  </div>
  <div class="mt-16 flex w-full gap-4 text-xsm">
    <FooterLink href="https://github.com/Rolandt10/rolandtoth.com"
      >GitHub</FooterLink
    >
    <FooterLink href="/colophon">Colophon</FooterLink>
  </div>
</footer>
