---
import { BookIcon } from "../Icons/Icons.tsx";

const API_URL =
  "https://za0j0wwqi3.execute-api.us-east-1.amazonaws.com/prod/currently-reading";

let book = null;
let errorMessage = null;

try {
  const response = await fetch(API_URL);
  if (!response.ok) throw new Error("Failed to fetch book");
  book = await response.json();
} catch (error) {
  errorMessage = error.message;
  console.error("Error fetching book data:", error);
}
---

  {
    errorMessage ? 
    (
      <div>
        <div class="border-dark-600 border-solid border-[1px] h-[6rem] w-16 rounded-md dark:bg-dark-700 flex justify-center items-center"><BookIcon size={24} stroke-width="1.6" className="dark:text-dark-300"/></div>
      </div>
      <div class="flex flex-col gap-1">
        <p class="leading-none">Couldn't load book</p>
      </div>
      ) : (
        book ? 
        <a href={book.externalUrl} class="flex gap-4">
        <img class="w-[4.1343rem] rounded-md shadow-md" src={book.bookCover} alt={book.bookTitle} />
        <div class="flex flex-col gap-1">
          <p class="text-base leading-none">{book.bookTitle}</p>
          <p class="text-sm dark:text-dark-300 text-light-400">{book.bookAuthors}</p>
        </div>
      </a>
    :
    <div>
        <div class="border-dark-600 border-solid border-[1px] h-[6rem] w-16 rounded-md dark:bg-dark-700 flex justify-center items-center"><BookIcon size={24} stroke-width="1.6" className="dark:text-dark-300"/></div>
      </div>
      <div class="flex flex-col gap-1">
        <p class="leading-none">Currently not reading anything</p>
      </div>
    )
  }



