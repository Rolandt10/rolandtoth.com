---
import { getCollection } from "astro:content";
import PostList from "../Posts/PostList.astro";

const numberOfPosts = (await getCollection("posts")).length;
---

<section class="pb-24">
  <header
    class="mb-24 flex items-baseline justify-between border-b border-light-400/20 dark:border-b-dark-500/75"
  >
    <h2 class="pb-3 text-lg text-light-600 dark:text-dark-0">Latest posts</h2>
    <a
      href="/posts"
      class="flex items-center gap-1 text-xsm dark:text-dark-200"
    >
      <span
        class="relative text-light-400 after:absolute after:bottom-0 after:left-0 after:h-[1px] after:w-full after:bg-dark-400 after:transition-colors after:hover:bg-dark-300/90"
        >View all ({numberOfPosts})</span
      ></a
    >
  </header>
  <PostList />
</section>
