---
interface ImageData {
  src: string;
  alt: string;
  caption: string;
}

const { src, alt, caption }: ImageData = Astro.props as ImageData;
---

<figure class="relative mb-8 w-full">
  <img
    src={src}
    alt={alt}
    class="relative left-1/2 w-[min(100vw,calc(100%+19rem))] max-w-none -translate-x-1/2 rounded-none transition-all duration-300 ease-in-out sm:rounded-lg"
  />
  <figcaption class="border-b py-2 text-xsm dark:border-dark-500">
    {caption}
  </figcaption>
</figure>
