---
interface ImageData {
  src: string;
  alt: string;
  caption: string;
}

const { src, alt, caption }: ImageData = Astro.props as ImageData;
---

<figure class="-mx-6 mb-8 w-[calc(100%+3rem)] xl:mx-auto xl:max-w-[75rem]">
  <img
    src={src}
    alt={alt}
    class="h-auto w-full max-w-none rounded-none xl:rounded-2xl"
  />
  <figcaption
    class="mx-auto max-w-[620px] border-b py-2 text-xsm max-sm:mx-6 dark:border-dark-500"
  >
    {caption}
  </figcaption>
</figure>
