---
import { Code } from "../Icons/Icons.tsx";
---

<div class="relative flex rounded-xl p-[0.375rem] dark:bg-dark-700/70">
  <div
    class="absolute left-0 top-0 flex h-9 w-9 -translate-x-1/3 -translate-y-1/3 items-center justify-center rounded-full border bg-dark-600 dark:border-dark-400/50"
  >
    <Code size={16} aria-label="Code icon" />
  </div>
  <div
    class="flex w-full rounded-lg border border-dashed p-4 dark:border-dark-400/50"
  >
    <ul class="flex flex-wrap gap-4">
      <slot />
    </ul>
  </div>
</div>
